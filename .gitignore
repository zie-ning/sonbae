# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/

# 환경 변수 (API 키 등)
.env

# 수집한 원문 캐시: 저작권 정책상 배포하지 않음
data/raw/

# 빌드 산출물: 검색 DB는 entries.jsonl에서 생성
*.sqlite
*.db
*.sqlite.tmp

# 보기용 변환 산출물 (pipeline.view)
data/.view/

# IDE
.idea/
.vscode/

# M5 검색 평가용 임베딩 캐시 (eval/search_embed.py)
eval/search/embeddings/

# M5 검색 실험용 LLM 생성물 캐시와 확장 DB (eval/search_llm.py)
eval/search/llm_cache/

# 계획 모드가 자동으로 만드는 계획 파일 (저장소에 둘 사본은 m{N}-{이름}.md로 따로 저장)
.claude/plans/*
!.claude/plans/m[0-9]*.md

# M7 에이전트 평가 원본 로그와 로컬 경로가 든 MCP 설정 (eval/agent_run.py). records.jsonl만 커밋
eval/runs/agent/*/raw/
eval/runs/agent/*/mcp_*.json
# 호출률 평가(eval/agent_call_run.py)가 서버 버전별로 꺼내 설치한 코드와 가상 환경
eval/runs/agent/*/servers/

# M10 리랭커 점수 캐시 (eval/search_rerank.py)
eval/search/rerank_cache/

# 발표 자료 (개인 보관용, 커밋하지 않음)
docs/발표*
